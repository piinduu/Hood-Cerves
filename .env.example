# Copia este archivo a .env y rellena los valores para desarrollo local.
# En Vercel, estas mismas variables se configuran en
# Settings -> Environment Variables (Production y Preview). NUNCA subas
# valores reales a git ni los pegues en el README.

# Postgres. Si usas Vercel Postgres/Neon, Vercel la rellena sola al conectar
# la base de datos al proyecto (pestaña Storage).
DATABASE_URL=

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY debe tener el mismo valor que VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Protege las rutas /api/cron/* y /api/admin/* (elige un valor aleatorio largo).
CRON_SECRET=

# Contraseña compartida de acceso a la web y token interno de sesión
# (elige valores propios, no reutilices ninguno que haya aparecido en el
# historial de git o en documentación).
SITE_PASSWORD=
SITE_AUTH_TOKEN=
